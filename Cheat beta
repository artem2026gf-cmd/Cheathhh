local Fader = {}
Fader.__index = Fader

local function fadeProps(o)
    if o:IsA("UIStroke") then
        return {"Transparency"}
    end

    if not o:IsA("GuiObject") then
        return nil
    end

    if o:IsA("ScrollingFrame") then
        return {"BackgroundTransparency", "ScrollBarImageTransparency"}
    end

    if o:IsA("ViewportFrame") or o:IsA("ImageLabel") or o:IsA("ImageButton") then
        return {"BackgroundTransparency", "ImageTransparency"}
    end

    if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then
        return {"BackgroundTransparency", "TextTransparency"}
    end

    return {"BackgroundTransparency"}
end

function Fader.new(root, skip)
    return setmetatable({
        Root = root,
        Skip = skip,
        Seen = {},
        List = {},
        A = 0,
        _tok = 0
    }, Fader)
end

function Fader:_add(o)
    self.Seen[o] = true
    local props = fadeProps(o)
    if not props then
        return
    end

    for _, p in ipairs(props) do
        table.insert(self.List, {o, p, o[p]})
    end
end

function Fader:Refresh()
    if not self.Seen[self.Root] then
        self:_add(self.Root)
    end

    for _, o in ipairs(self.Root:GetDescendants()) do
        if not self.Seen[o] and not (self.Skip and self.Skip(o)) then
            self:_add(o)
        end
    end
end

function Fader:_apply()
    local a = self.A

    for _, it in ipairs(self.List) do
        local o = it[1]
        if o.Parent then
            o[it[2]] = it[3] + (1 - it[3]) * a
        end
    end
end

function Fader:Set(a, t, delay)
    self:Refresh()
    self._tok += 1
    local tok = self._tok

    if not t or t <= 0 then
        self.A = a
        self:_apply()
        return
    end

    task.spawn(function()
        if delay and delay > 0 then
            task.wait(delay)
            if tok ~= self._tok then
                return
            end
        end

        local from = self.A
        local t0 = os.clock()

        while self._tok == tok do
            local k = math.min(1, (os.clock() - t0) / t)
            self.A = from + (a - from) * TweenService:GetValue(
                k,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out
            )
            self:_apply()

            if k >= 1 then
                break
            end

            RunService.RenderStepped:Wait()
        end
    end)
end

