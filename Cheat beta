}

local function sanitize(m)
    local parts = 0

    for _, d in ipairs(m:GetDescendants()) do
        local junk = false

        for _, cls in ipairs(JUNK) do
            if d:IsA(cls) then
                junk = true
                break
            end
        end

        if junk then
            d:Destroy()
        elseif d:IsA("BasePart") then
            parts += 1
            d.Anchored = true
            d.CastShadow = false
            pcall(function()
                d.LocalTransparencyModifier = 0
            end)
        elseif d:IsA("Motor6D") then
            pcall(function()
                d.Transform = CFrame.new()
            end)
        end
    end

    return parts
end

local function bounds(m)
    local mn, mx

    for _, p in ipairs(m:GetDescendants()) do
        if p:IsA("BasePart") and p.Transparency < 0.9 and p.Name ~= "HumanoidRootPart" then
            local h, r = p.Size / 2, p.CFrame

            local ex = math.abs(r.RightVector.X) * h.X
                + math.abs(r.UpVector.X) * h.Y
                + math.abs(r.LookVector.X) * h.Z

            local ey = math.abs(r.RightVector.Y) * h.X
                + math.abs(r.UpVector.Y) * h.Y
                + math.abs(r.LookVector.Y) * h.Z

            local ez = math.abs(r.RightVector.Z) * h.X
                + math.abs(r.UpVector.Z) * h.Y
                + math.abs(r.LookVector.Z) * h.Z

            local e = Vector3.new(ex, ey, ez)
            local lo, hi = p.Position - e, p.Position + e

            if not mn then
                mn, mx = lo, hi
            else
                mn = Vector3.new(
                    math.min(mn.X, lo.X),
                    math.min(mn.Y, lo.Y),
                    math.min(mn.Z, lo.Z)
                )

                mx = Vector3.new(
                    math.max(mx.X, hi.X),
                    math.max(mx.Y, hi.Y),
                    math.max(mx.Z, hi.Z)
                )
            end
        end
    end

    if not mn then
        local cf, size = m:GetBoundingBox()
        return cf.Position, size
    end

    return (mn + mx) / 2, mx - mn
end

local function cloneChar(char)
    local prev = char.Archivable
    char.Archivable = true
    local ok, c = pcall(function()
        return char:Clone()
    end)
    char.Archivable = prev

    if ok then
        return c
    end

    return nil
end

