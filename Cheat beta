    while state.running and env.BlockStrikeSilentState == state do
        if not validWeapon(state.weapon) then
            state.weapon = nil
            state.target = nil

            if type(getgc) == "function" then
                local ok, objects = pcall(getgc, true)

                if ok and type(objects) == "table" then
                    for _, object in ipairs(objects) do
                        if not state.running or env.BlockStrikeSilentState ~= state then
                            break
                        end

                        if validWeapon(object) then
                            state.weapon = object
                            break
                        end
                    end
                end
            end
        end

        task.wait(1)
    end
end)

