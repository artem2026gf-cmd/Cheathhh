local function iconButton(parent, fromRight, image, spin)
    local b = new("TextButton", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(1, -fromRight, 0.5, 0),
        Size = UDim2.fromOffset(28, 28),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        Parent = parent
    })

    local sc = new("UIScale", {
        Parent = b
    })

    local img = new("ImageLabel", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(20, 20),
        BackgroundTransparency = 1,
        Image = image,
        ImageColor3 = C.Text,
        Parent = b
    })

    b.MouseEnter:Connect(function()
        tween(sc, 0.2, {Scale = 1.1})
        tween(img, 0.25, {
            ImageColor3 = C.AccentText,
            Rotation = spin and 90 or 0
        })
    end)

    b.MouseLeave:Connect(function()
        tween(sc, 0.3, {Scale = 1}, Enum.EasingStyle.Back)
        tween(img, 0.3, {
            ImageColor3 = C.Text,
            Rotation = 0
        })
    end)

    b.MouseButton1Down:Connect(function()
        tween(sc, 0.1, {Scale = 0.88})
    end)

    b.MouseButton1Up:Connect(function()
        tween(sc, 0.35, {Scale = 1.05}, Enum.EasingStyle.Back)
    end)

    return b
end
