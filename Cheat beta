local function healthState(object)
    if not object then
        return nil
    end

    if object:GetAttribute("Dead") == true then
        return false
    end

    local health = object:GetAttribute("Health")
    if typeof(health) == "number" then
        return health > 0
    end

    return nil
end

local function validModel(model, owner)
    if not model or not model:IsDescendantOf(Workspace)
        or model == LocalPlayer.Character then
        return false
    end

    if owner then
        if owner.Parent ~= Players or owner.Character ~= model then
            return false
        end
    elseif model:GetAttribute("Bot") ~= true then
        return false
    end

    local modelAlive = healthState(model)
    local ownerAlive = healthState(owner)

    if modelAlive == false or ownerAlive == false then
        return false
    end

    if modelAlive ~= true and ownerAlive ~= true then
        return false
    end

    local myTeam = LocalPlayer:GetAttribute("Team")
    local team = owner and owner:GetAttribute("Team") or model:GetAttribute("Team")

    return typeof(myTeam) == "string"
        and myTeam ~= ""
        and typeof(team) == "string"
        and team ~= ""
        and team ~= myTeam
end

local function validWeapon(weapon)
    if type(weapon) ~= "table" then
        return false
    end

    local ok, valid = pcall(function()
        return weapon.Player == LocalPlayer
            and weapon.IsEquipped == true
            and weapon.IsDestroyed ~= true
            and type(weapon.Properties) == "table"
            and type(weapon.Bullet) == "table"
            and weapon.Bullet.IsDestroyed ~= true
            and weapon.Bullet.Weapon == weapon
    end)

    return ok and valid
end

local function localPosition(camera)
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")

    if root and root:IsA("BasePart") then
        return root.Position
    end

    return camera.CFrame.Position
end

local function inDistance(position, camera)
    return state.maxDistance >= 2000
        or (position - localPosition(camera)).Magnitude <= state.maxDistance
end

local function screenAllowed(position, camera)
    if state.priority == "360" then
        return true
    end

    local screen, onScreen = camera:WorldToViewportPoint(position)
    if not onScreen or screen.Z <= 0 then
        return false
    end

    if state.priority == "FOV" then
        local center = camera.ViewportSize / 2
        return (Vector2.new(screen.X, screen.Y) - center).Magnitude <= state.fov
    end

    return true
end

local function tracePoint(origin, position, model, part, properties, ignore)
    if type(properties) ~= "table" then
        return nil
    end

    local offset = position - origin
    local distance = offset.Magnitude
    local range = properties.Range or 500
    local penetration = properties.Penetration or 0

    if distance < 0.001
        or typeof(range) ~= "number"
        or range <= 0
        or distance > range
        or typeof(penetration) ~= "number" then
        return nil
    end

    local direction = offset.Unit

    local ok, hits = pcall(
        raycast.castThroughDistance,
        origin,
        direction * range,
        penetration,
        ignore
    )

    if not ok or type(hits) ~= "table" then
        return nil
    end

    local blocked = false

    for _, hit in ipairs(hits) do
        local instance = hit.instance

        if typeof(instance) == "Instance" then
            if instance:IsDescendantOf(model) then
                if instance ~= part then
                    return nil
                end

                return blocked and "wallbang" or "visible", hits, direction, range
            end

            blocked = true
        end
    end

    return nil
end

local function collectCandidates(camera)
    local candidates = {}
    local center = camera.ViewportSize / 2
    local origin = localPosition(camera)

    local function add(model, owner)
        if not validModel(model, owner) then
            return
        end

        local part = model:FindFirstChild("Head")
            or model:FindFirstChild("HumanoidRootPart")

        if not part or not part:IsA("BasePart") then
            return
        end

        local distance = (part.Position - origin).Magnitude

        if state.maxDistance < 2000 and distance > state.maxDistance then
            return
        end

        local score

        if state.priority == "360" then
            score = distance
        else
            local screen, onScreen = camera:WorldToViewportPoint(part.Position)

            if not onScreen or screen.Z <= 0 then
                return
            end

            score = (Vector2.new(screen.X, screen.Y) - center).Magnitude
        end

        table.insert(candidates, {
            model = model,
            owner = owner,
            score = score
        })
    end

    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= LocalPlayer then
            add(other.Character, other)
        end
    end

    local characters = Workspace:FindFirstChild("Characters")

    if characters then
        for _, model in ipairs(characters:GetChildren()) do
            if model:IsA("Model") and model:GetAttribute("Bot") == true then
                add(model, nil)
            end
        end
    end

    table.sort(candidates, function(a, b)
        return a.score < b.score
    end)

    return candidates
end

local function findPoint(model, owner, camera, origin, properties, ignore)
    if not validModel(model, owner) then
        return nil
    end

    for _, name in ipairs(partNames) do
        local part = model:FindFirstChild(name)

        if part and part:IsA("BasePart") and part.CanQuery then
            for _, offset in ipairs(offsets) do
                local localOffset = Vector3.new(
                    part.Size.X * offset.X,
                    part.Size.Y * offset.Y,
                    part.Size.Z * offset.Z
                )

                local position = part.CFrame:PointToWorldSpace(localOffset)

                if inDistance(position, camera) and screenAllowed(position, camera) then
                    local kind = tracePoint(
                        origin,
                        position,
                        model,
                        part,
                        properties,
                        ignore
                    )

                    if kind then
                        return {
                            model = model,
                            owner = owner,
                            part = part,
                            localOffset = localOffset,
                            kind = kind
                        }
                    end
                end
            end
        end
    end

    return nil
end

local function findTarget()
    local weapon = state.weapon
    local camera = Workspace.CurrentCamera

    if not camera or not validWeapon(weapon) then
        return nil
    end

    local center = camera.ViewportSize / 2
    local origin = camera:ViewportPointToRay(center.X, center.Y).Origin
    local ignore = getIgnore()
    local candidates = collectCandidates(camera)

    for i = 1, math.min(3, #candidates) do
        local entry = candidates[i]
        local found = findPoint(
            entry.model,
            entry.owner,
            camera,
            origin,
            weapon.Properties,
            ignore
        )

        if found then
            return found
        end
    end

    return nil
end

local function checkTarget(target, properties)
    if not target or not target.part or not target.model
        or not target.part:IsDescendantOf(target.model)
        or not target.part.CanQuery
        or not validModel(target.model, target.owner) then
        return nil
    end

    local camera = Workspace.CurrentCamera
    if not camera then
        return nil
    end

    local position = target.part.CFrame:PointToWorldSpace(target.localOffset)

    if not inDistance(position, camera) or not screenAllowed(position, camera) then
        return nil
    end

    local center = camera.ViewportSize / 2
    local origin = camera:ViewportPointToRay(center.X, center.Y).Origin

    local kind, hits, direction, range = tracePoint(
        origin,
        position,
        target.model,
        target.part,
        properties,
        getIgnore()
    )

    return kind, hits, direction, range, origin
end

local original

original = hookfunction(bullet._performRaycast, function(self, spread)
    if env.BlockStrikeSilentState ~= state or not state.running then
        return original(self, spread)
    end

    local weapon = self.Weapon

    if validWeapon(weapon) and weapon.Bullet == self and state.weapon ~= weapon then
        state.weapon = weapon
        state.target = nil
    end

    if not state.enabled
        or state.weapon ~= weapon
        or not state.target
        or math.random(1, 100) > state.hitChance then
        return original(self, spread)
    end

    local success, result = pcall(function()
        local kind, hits, direction, range, origin = checkTarget(
            state.target,
            self.Properties
        )

        if not kind then
            return nil
        end

        local formattedHits = {}

        for index, hit in ipairs(hits) do
            table.insert(formattedHits, {
                Position = hit.position,
                Instance = hit.instance,
                Material = hit.material.Name,
                Normal = hit.normal,
                Exit = index % 2 == 0
            })
        end

        return {
            Origin = origin,
            Direction = direction,
            Distance = range,
            Hits = formattedHits
        }
    end)

    if success and result then
        return result
    end

    return original(self, spread)
end)

